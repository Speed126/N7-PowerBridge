{
  "manifest_version": 3,
  "name": "N7 PowerBridge",
  "version": "1.0.0",
  "description": "Parse N7 World powers and transfer them into Roll20 character sheets.",
  "minimum_chrome_version": "102",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://n7.world/*", "https://*.n7.world/*"],
      "js": ["src/power-parser.js", "src/n7-content.js"]
    },
    {
      "matches": ["https://app.roll20.net/*"],
      "js": ["src/roll20-content.js"],
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
